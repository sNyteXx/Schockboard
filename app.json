{
  "expo": {
    "name": "Schockboard Next",
    "slug": "schockboard-next",
    "version": "2.0.0",
    "scheme": "schockboard-next",
    "orientation": "default",
    "icon": "./assets/next-icon.png",
    "userInterfaceStyle": "dark",
    "experiments": {
      "typedRoutes": true
    },
    "splash": {
      "image": "./assets/next-icon-foreground.png",
      "resizeMode": "contain",
      "backgroundColor": "#101210"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "de.schockboard.next",
      "versionCode": 208,
      "adaptiveIcon": {
        "backgroundColor": "#101210",
        "foregroundImage": "./assets/next-icon-foreground.png",
        "monochromeImage": "./assets/next-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/next-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-sharing",
      "expo-font",
      "expo-background-task",
      [
        "expo-camera",
        {
          "cameraPermission": "Schockboard benötigt die Kamera zum Scannen einer Geräte-Einladung.",
          "recordAudioAndroid": false
        }
      ]
    ]
  }
}
